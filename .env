# --- Cekirdek ----------------------------------------------------------------
KERNEL_MODE=monolithic
RING=3
GRAVITY_CONSTANT=9.81
KERNEL_PANIC_SEBEBI=kullanici_yine_halt_yazdi
HALT_KOMUTUNUN_YENI_ADI=dumb

# --- Kimlik ------------------------------------------------------------------
ROOT_PASSWORD=hunter2
ADMIN_PASSWORD=admin123_ama_bu_sefer_ciddiyim
SUDO_SIFRESI=sudo_yok_ki_bizde
BIOS_SIFRESI=lutfen_pili_cikarma

# --- Bellek ------------------------------------------------------------------
RAM_MIKTARI=yeterli
KMALLOC_STRATEJISI=en_iyisini_umut_et
KFREE_CALISIYOR_MU=evet_bu_sefer_gercekten
BELLEK_SIZINTISI=sadece_biraz

# --- Ag ----------------------------------------------------------------------
IP_ADRESI=10.0.2.15
DNS_SUNUCUSU=henuz_yok
TCP_DURUMU=yazilmadi_sorma
APT_UPDATE_CALISIR_MI=hayir_ve_calismayacak
PING_HEDEFI=10.0.2.2

# --- Disk --------------------------------------------------------------------
DOSYA_SISTEMI=FAT32
UZUN_DOSYA_ADI_DESTEGI=8.3_ile_idare_et
YEDEK_ALDIN_MI=git_var_ya

